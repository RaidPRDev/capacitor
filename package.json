{
  "name": "elso_app",
  "private": true,
  "version": "1.0.1",
  "build_number": "330",
  "type": "module",
  "scripts": {
    "postinstall": "node app.config.js",
    "start": "node app.config.js --web-only && vite --host",
    "preview": "vite preview",
    "update_version": "node app.update.js",
    "config": "node app.config.js",
    "config_list": "node app.config.js --list",
    "build": "node app.config.js && vue-tsc --noEmit && vite build",
    "sync": "node app.config.js && npx cap sync",
    "android_open": "node app.config.js && npx cap open android",
    "android_run": "node app.config.js && npx cap run android",
    "ios_run": "pwsh -NoProfile -File tools/mac/Mac-Run-iOS.ps1",
    "ios_live": "pwsh -NoProfile -File tools/mac/Mac-Run-iOS.ps1 -Live",
    "ios_logs": "pwsh -NoProfile -File tools/mac/Mac-Logs-iOS.ps1",
    "ios_doctor": "pwsh -NoProfile -File tools/mac/Mac-Doctor.ps1",
    "icons": "npx capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@streamparser/json-whatwg": "^0.0.21",
    "my-clarity-capacitator-plugin": "file:my-clarity-capacitator-plugin"
  },
  "overrides": {
    "@capacitor/assets": {
      "@capacitor/cli": "$@capacitor/cli"
    },
    "minimatch": "^9.0.5",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "classnames": "^2.5.1",
    "pinch-zoom-js": "^2.3.5",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.0.2",
    "sass": "1.77.6",
    "typescript": "5.8.3",
    "vite": "^7.0.6",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-tsc": "3.0.4"
  }
}